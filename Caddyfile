# Caddyfile — Warm-standby reverse proxy for Rico AI.
#
# This is a WARM STANDBY artifact. It does NOT replace the Vercel/Render
# production path. During routine validation, Caddy serves the standby
# stack on localhost or a private network only.
#
# For zero-hour activation on a VPS, replace :80 with the production
# domain and Caddy will auto-provision TLS certificates. See
# docs/local-docker-production.md §C for the activation procedure.
#
# Architecture:
#   :80/        → web:3000      (Next.js frontend, including /proxy/* BFF routes)
#   :80/health  → backend:8000  (Direct backend health check — operational only)
#   :80/ready   → backend:8000  (Direct backend readiness check — operational only)
#   :80/version → backend:8000  (Direct backend version check — operational only)
#
# The Next.js /proxy/* route is the BFF boundary for account-scoped API calls.
# Caddy does NOT route /api/* directly to FastAPI — all application traffic
# traverses Next.js to preserve the same-origin boundary.

# ── Local validation (no TLS) ─────────────────────────────────────────
# For VPS activation, replace :80 with the production domain name
# (e.g. ricohunt.com) and Caddy will auto-provision HTTPS.
:80 {
	# Security headers
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	# Operational endpoints — direct to backend (health/readiness/version only)
	handle /health {
		reverse_proxy backend:8000
	}

	handle /ready {
		reverse_proxy backend:8000
	}

	handle /version {
		reverse_proxy backend:8000
	}

	# Everything else — proxy to Next.js frontend
	handle {
		reverse_proxy web:3000
	}
}
