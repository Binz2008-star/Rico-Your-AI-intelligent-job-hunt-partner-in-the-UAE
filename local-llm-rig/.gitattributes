* text=auto

# PowerShell is happiest with CRLF on Windows, and some older hosts choke on LF.
*.ps1 text eol=crlf

# Keep these LF so the Python and Ollama tooling reads them identically everywhere.
*.py    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.Modelfile text eol=lf
LICENSE text eol=lf
