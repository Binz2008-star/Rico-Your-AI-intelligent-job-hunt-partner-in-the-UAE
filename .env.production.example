# .env.production.example
# Warm-standby environment template for Rico AI Docker stack.
#
# ──────────────────────────────────────────────────────────────────────
# WARM-STANDBY SAFEGUARDS — READ BEFORE EDITING
# ──────────────────────────────────────────────────────────────────────
#
# This file is for the Docker warm-standby stack ONLY.
# It does NOT replace the Vercel/Render/Neon production environment.
#
# The following features are DISABLED by default in this file and in
# docker-compose.production.yml (compose-level overrides take precedence):
#
#   - Auto-apply:          RICO_ENABLE_AUTO_APPLY=false
#   - Approval required:   RICO_REQUIRE_APPROVAL_FOR_APPLICATIONS=true
#   - Scheduled searches:  RICO_ENABLE_SCHEDULED_SEARCHES=false
#   - Signup email alerts: ENABLE_SIGNUP_EMAIL_NOTIFICATIONS=false
#   - Learning:            RICO_ENABLE_LEARNING=false
#   - RQ worker:           Disabled via Docker Compose profile (does not start)
#
# DO NOT set the following in this file during routine validation:
#
#   - TELEGRAM_BOT_TOKEN   (prevents Telegram messages)
#   - EMAIL_USER           (prevents outbound email)
#   - EMAIL_PASS           (prevents outbound email)
#
# These should only be set during a controlled zero-hour activation.
# See docs/local-docker-production.md §C for the activation procedure.
#
# ──────────────────────────────────────────────────────────────────────
# DATABASE — USE STAGING/TEST ONLY
# ──────────────────────────────────────────────────────────────────────
#
# During routine validation, DATABASE_URL must point to a staging or test
# PostgreSQL instance — NEVER production Neon.
#
# For local validation with the dev docker-compose.yml's PostgreSQL:
#   DATABASE_URL=postgresql://rico:rico@localhost:5432/rico
#
# For a staging Neon branch:
#   DATABASE_URL=postgresql://user:pass@ep-staging-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
#
# ──────────────────────────────────────────────────────────────────────

# ── Database (staging/test only — NEVER production Neon) ───────────────
DATABASE_URL=postgresql://rico:rico@localhost:5432/rico

# ── JWT and Auth ──────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-random-64-char-string

# ── Admin credentials (standby only — not production admin) ───────────
ADMIN_EMAIL=standby-admin@example.com
ADMIN_PASSWORD=change-me-standby-only

# ── Cookie security ───────────────────────────────────────────────────
# Set to true if serving over HTTPS. false for local validation over HTTP.
COOKIE_SECURE=false

# ── CORS ──────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. For local validation:
CORS_ORIGINS=http://localhost:80,http://localhost:3000

# ── AI Providers (optional — leave blank for health-check-only standby) ─
# Only set if you want the standby to perform AI reasoning during validation.
# Leave blank to test health/readiness without AI provider calls.
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# RICO_AI_PROVIDER=none

# ── Redis (set by docker-compose.production.yml — do not override) ────
# REDIS_URL is set in docker-compose.production.yml as redis://redis:6379/0

# ── Warm-standby feature flags (also enforced in docker-compose) ──────
RICO_ENABLE_AUTO_APPLY=false
RICO_REQUIRE_APPROVAL_FOR_APPLICATIONS=true
RICO_ENABLE_SCHEDULED_SEARCHES=false
ENABLE_SIGNUP_EMAIL_NOTIFICATIONS=false
RICO_ENABLE_LEARNING=false

# ── Side-effecting integrations — LEAVE BLANK during routine validation ─
# Only set during controlled zero-hour activation (see docs/local-docker-production.md §C)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# EMAIL_USER=
# EMAIL_PASS=

# ── JotForm (leave blank — onboarding webhook integration) ────────────
# JOTFORM_API_KEY=
# JOTFORM_FORM_ID=
# JOTFORM_WEBHOOK_SECRET=

# ── Sentry (optional — set DSN to enable error tracking on standby) ──
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=standby
# SENTRY_TRACES_SAMPLE_RATE=0.0

# ── Deployment metadata ───────────────────────────────────────────────
# Set GIT_COMMIT to the exact approved commit SHA during zero-hour activation.
GIT_COMMIT=unknown

# ── Billing (leave disabled — do NOT set Paddle keys in standby) ──────
# BILLING_MODE=manual
# PADDLE_API_KEY=
# PADDLE_WEBHOOK_SECRET=
